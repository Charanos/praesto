{
  "name": "praesto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Praesto - pharmacy product availability and evidence workspace for Kenya",
  "scripts": {
    "prebuild": "node dev/stamp-read-model.mjs",
    "build": "vite build",
    "pipeline:build": "node pipeline/build.js",
    "verify": "node pipeline/verify.js",
    "reclassify": "node pipeline/reclassify.js",
    "refresh": "npm run pipeline:build && node pipeline/verify.js && node pipeline/export-app.js && npm run build",
    "ci": "node pipeline/build.js --strict && node pipeline/verify.js && node pipeline/export-app.js && npm run build",
    "predev": "node dev/stamp-read-model.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "build:app": "npm run build",
    "export:app": "node pipeline/export-app.js",
    "lint": "eslint src dev",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" dev/stamp-read-model.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" dev/stamp-read-model.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm test && npm run verify && npm run build",
    "check:app": "npm run typecheck && npm run format:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "@radix-ui/react-select": "2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0"
  }
}
